{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TEDcNOW Client Lead",
  "description": "Fields the customer agent captures and hands off to the CRM (Google Sheet / HubSpot / Notion).",
  "type": "object",
  "required": ["lead_id", "created_at", "name", "phone", "event_type", "city", "consent_share_with_vendors", "temperature"],
  "properties": {
    "lead_id": { "type": "string", "description": "e.g. TN-2026-0001" },
    "created_at": { "type": "string", "format": "date-time", "description": "IST timestamp" },
    "channel": { "type": "string", "enum": ["whatsapp", "website_chat", "voice", "instagram", "facebook", "referral", "other"] },
    "lead_type": { "type": "string", "enum": ["D2C_client", "B2B_planner", "B2B_corporate", "vendor_signup"] },
    "name": { "type": "string" },
    "role": { "type": "string", "enum": ["bride", "groom", "family", "corporate", "event_planner", "other"] },
    "company": { "type": "string" },
    "phone": { "type": "string", "description": "WhatsApp number with +91" },
    "email": { "type": "string" },
    "preferred_call_time_ist": { "type": "string" },
    "language": { "type": "string", "enum": ["english", "hindi", "hinglish", "other"] },
    "event_type": { "type": "string" },
    "event_dates": { "type": "string", "description": "Exact dates or flexible window" },
    "city": { "type": "string" },
    "guest_count": { "type": "integer" },
    "categories_needed": { "type": "array", "items": { "type": "string" } },
    "budget_inr": { "type": "string", "description": "Overall or per category; ranges allowed" },
    "venue_status": { "type": "string", "enum": ["booked", "shortlisted", "need_help", "unknown"] },
    "decision_by": { "type": "string" },
    "style_notes": { "type": "string" },
    "consent_share_with_vendors": { "type": "boolean" },
    "consent_marketing_whatsapp": { "type": "boolean" },
    "temperature": { "type": "string", "enum": ["HOT", "WARM", "COLD"] },
    "handoff_reason": { "type": "string" },
    "assigned_rm": { "type": "string" },
    "status": { "type": "string", "enum": ["new", "contacted", "shortlist_sent", "vendor_meeting", "booked", "lost", "on_hold"], "default": "new" },
    "booked_value_inr": { "type": "number", "description": "Filled after booking; drives 5% commission tracking" },
    "commission_inr": { "type": "number", "description": "booked_value_inr x applicable commission % per vendor agreement" },
    "notes": { "type": "string" }
  }
}
